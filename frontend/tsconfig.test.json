{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": ".tmp-tests",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/service-details/**/*.ts",
    "src/features/service-details/**/*.tsx",
    "src/features/service-deployments/**/*.ts",
    "src/features/service-deployments/**/*.tsx",
    "src/features/service-settings/**/*.ts",
    "src/features/service-settings/**/*.tsx",
    "src/lib/**/*.ts",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
